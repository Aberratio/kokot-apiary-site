# Copy to .env.local for local work. On Vercel these are project environment variables.

# Neon Postgres (set by the Neon integration on Vercel). Without it the public page shows the
# placeholder content and /admin cannot save.
DATABASE_URL=

# Vercel Blob read-write token, for product photos.
BLOB_READ_WRITE_TOKEN=

# Admin login. Generate both with: npm run admin:hash -- "<password>"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional: the public URL once the site has its own domain.
NEXT_PUBLIC_SITE_URL=
